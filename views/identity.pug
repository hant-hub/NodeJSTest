doctype html
html(lang='en')
head
    title Time Keeper
    link(
            rel="stylesheet"
            href="main.css"
        )
body
    h2 Set Identity
    div(
        id="text-div"
    )
        input(
            type="text"
            id="identity-set"
        )
    div(
        id="button-div"
    )
        button(
                id="identity-submit"
                onclick="setIdentity();"
              ) Set
    script(
            src="id.js"
          )
